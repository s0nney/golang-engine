package views

import (
	"fmt"
	"slices"

	"goland-engine/internal/course"
	"goland-engine/internal/store"
)

// Link points at a lesson.
type Link struct {
	URL    string
	Title  string
	Course string // title of the lesson's course, set only when the link leaves the current course
}

// CourseCard is a course on the roadmap with the learner's progress.
type CourseCard struct {
	store.CourseSummary
	Done int
}

// Outline is a course page with the learner's progress.
type Outline struct {
	Course   course.Course
	Done     map[store.LessonKey]bool
	Continue *Link // first unfinished lesson; nil when the course is finished
}

// Lesson is everything the lesson page renders.
type Lesson struct {
	Course       course.Course // outline only
	ChapterTitle string
	Lesson       course.Lesson
	URL          string
	Number       int // 1-based position within the course
	Total        int
	Prev, Next   *Link
	Complete     bool
	Quiz         *QuizResult // nil until the quiz is submitted
	Code         string      // editor contents
	Output       *RunResult  // nil until code is run
}

// QuizResult is a graded quiz submission.
type QuizResult struct {
	Chosen  []int // chosen option per question, -1 if unanswered
	Correct []bool
	Passed  bool
}

// RunResult is the outcome of pressing Run or Submit.
type RunResult struct {
	Submit   bool // graded submission rather than a test run
	Passed   bool
	Output   string
	Expected string // set when a submission's output didn't match
	Next     *Link
	Complete bool // the lesson just became complete
	Practice bool // a practice problem rather than a lesson exercise
}

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/activity.js" defer></script>
		</head>
		<body>
			<header>
				<a href="/" class="brand">goland-engine</a>
				<nav><a href="/#courses">courses</a> <a href="/exercises">exercises</a></nav>
			</header>
			{ children... }
			<footer>
				<p>goland-engine. Learn to program, in Go.</p>
			</footer>
		</body>
	</html>
}

templ Home(courses []CourseCard, activity store.Activity) {
	@layout("goland-engine: learn to program in Go") {
		<main class="narrow">
			<h1>Learn to program. In Go.</h1>
			<p>
				Short lessons, one idea at a time, each with a quiz or a coding exercise to check you
				actually got it. Start at course 1 knowing nothing and finish able to build and test
				concurrent web services in Go, with object-oriented and functional design and the data
				structures and algorithms interviews are made of along the way.
			</p>
			<p>No account. No videos. Your progress is saved in this browser.</p>
			@Activity(activity)
			<h2 id="courses">The roadmap</h2>
			@roadmap(coreCourses(courses), 1)
			if beyond := beyondCourses(courses); len(beyond) > 0 {
				<h2 id="beyond">Beyond the core</h2>
				<p class="track-intro">
					Finished the core? These courses go deeper into specific topics. Take them in any
					order; nothing else on the roadmap depends on them.
				</p>
				@roadmap(beyond, len(courses)-len(beyond)+1)
			}
			<form method="post" action="/progress/reset" class="reset">
				<button type="submit" class="quiet" onclick="return confirm('Forget all progress, activity, and streaks in this browser?')">Reset my progress</button>
			</form>
		</main>
	}
}

// roadmap lists courses with their progress, numbered from start so a
// second list continues the first one's numbering.
templ roadmap(courses []CourseCard, start int) {
	<ol class="roadmap" start={ fmt.Sprint(start) }>
		for _, c := range courses {
			<li>
				<a href={ templ.SafeURL("/courses/" + c.Slug) }><strong>{ c.Title }</strong></a>
				<p>{ c.Description }</p>
				<small>
					{ fmt.Sprintf("%d chapters · %d lessons", c.Chapters, c.Lessons) }
					if c.Done > 0 {
						· <span class="done">{ fmt.Sprintf("%d done", c.Done) }</span>
					}
				</small>
				if c.Done > 0 {
					<progress max={ fmt.Sprint(c.Lessons) } value={ fmt.Sprint(c.Done) }></progress>
				}
			</li>
		}
	</ol>
}

func coreCourses(cs []CourseCard) []CourseCard {
	return slices.DeleteFunc(slices.Clone(cs), func(c CourseCard) bool { return c.Beyond })
}

func beyondCourses(cs []CourseCard) []CourseCard {
	return slices.DeleteFunc(slices.Clone(cs), func(c CourseCard) bool { return !c.Beyond })
}

templ Course(v Outline) {
	@layout(v.Course.Title + " · goland-engine") {
		<main class="narrow">
			<p class="crumbs"><a href="/">Roadmap</a></p>
			<h1>{ v.Course.Title }</h1>
			<p>{ v.Course.Description }</p>
			if v.Continue != nil {
				<p>
					<a class="button" href={ templ.SafeURL(v.Continue.URL) }>
						if len(v.Done) == 0 {
							Start course →
						} else {
							Continue: { v.Continue.Title } →
						}
					</a>
				</p>
			} else {
				<p class="done">You've finished this course.</p>
			}
			<ol class="chapters">
				for _, ch := range v.Course.Chapters {
					<li>
						<h2 id={ ch.Slug }>{ ch.Title }</h2>
						if ch.Description != "" {
							<p>{ ch.Description }</p>
						}
						<ol>
							for _, l := range ch.Lessons {
								<li>
									<a href={ templ.SafeURL(LessonURL(v.Course.Slug, ch.Slug, l.Slug)) }>{ l.Title }</a>
									if v.Done[store.LessonKey{Course: v.Course.Slug, Chapter: ch.Slug, Lesson: l.Slug}] {
										<span class="done" title="Completed">✓</span>
									}
								</li>
							}
						</ol>
					</li>
				}
			</ol>
		</main>
	}
}

templ LessonPage(v Lesson) {
	@layout(v.Lesson.Title + " · " + v.Course.Title) {
		<main class="lesson">
			<article>
				<div class="crumbs">
					<p>
						<a href={ templ.SafeURL("/courses/" + v.Course.Slug) }>{ v.Course.Title }</a>
						/ { v.ChapterTitle }
					</p>
					<div class="count">
						@status(v.Complete)
						{ fmt.Sprintf("%d / %d", v.Number, v.Total) }
						@lessonNav(v)
					</div>
				</div>
				<h1>{ v.Lesson.Title }</h1>
				@templ.Raw(v.Lesson.HTML)
			</article>
			<aside class="panels">
				if v.Lesson.Exercise != nil {
					@exercise(v.URL, v.Code, v.Output)
				}
				if len(v.Lesson.Quiz) > 0 {
					@quiz(v)
				}
			</aside>
			if v.Lesson.Exercise != nil {
				<script src="/static/editor.js" defer></script>
			}
			@pager(v)
		</main>
	}
}

// lessonNav is a compact previous/next pair at the top of a lesson, so long
// lessons don't need scrolling to move on.
templ lessonNav(v Lesson) {
	<nav class="lesson-nav" aria-label="Previous and next lesson">
		if v.Prev != nil {
			<a href={ templ.SafeURL(v.Prev.URL) } rel="prev" title={ v.Prev.Title }>← Previous</a>
		}
		if v.Next != nil {
			<a href={ templ.SafeURL(v.Next.URL) } rel="next" title={ v.Next.Title } class="next">Next →</a>
		}
	</nav>
}

// pager is the full-width previous/next buttons under a lesson. At the edge
// of a course it continues into the neighbouring course.
templ pager(v Lesson) {
	<nav class="pager" aria-label="Lesson navigation">
		if v.Prev != nil {
			<a class="pager-link prev" href={ templ.SafeURL(v.Prev.URL) } rel="prev">
				if v.Prev.Course != "" {
					<small>{ "← Previous course: " + v.Prev.Course }</small>
				} else {
					<small>← Previous lesson</small>
				}
				<span>{ v.Prev.Title }</span>
			</a>
		}
		if v.Next != nil {
			<a class="pager-link next" href={ templ.SafeURL(v.Next.URL) } rel="next">
				if v.Next.Course != "" {
					<small>{ "Next course: " + v.Next.Course + " →" }</small>
				} else {
					<small>Next lesson →</small>
				}
				<span>{ v.Next.Title }</span>
			</a>
		} else {
			<a class="pager-link next" href="/">
				<small>You've reached the end of the roadmap</small>
				<span>Back to the roadmap →</span>
			</a>
		}
	</nav>
}

templ status(complete bool) {
	<span id="lesson-status">
		if complete {
			<span class="done">✓ Completed</span> ·
		}
	</span>
}

// exercise is the code editor. With htmx, Run and Submit swap only the
// output; without it, the form posts and the whole page re-renders.
templ exercise(url, code string, out *RunResult) {
	<section class="panel" id="exercise">
		<h2>Exercise</h2>
		<form method="post" action={ templ.SafeURL(url + "#exercise") }>
			<label for="code" class="sr-only">Your code</label>
			<textarea
				id="code"
				name="code"
				data-editor
				rows="18"
				spellcheck="false"
				autocapitalize="off"
				autocomplete="off"
				hx-on:keydown="if (event.key === 'Tab' && !event.shiftKey && !event.ctrlKey && !event.altKey && !event.metaKey) { event.preventDefault(); this.setRangeText('\t', this.selectionStart, this.selectionEnd, 'end') } else if (event.key === 'Escape') { this.blur() }"
			>{ code }</textarea>
			<div class="editor-bar">
				<p class="hint">Tab indents. Press Esc, then Tab, to leave the editor.</p>
				<label class="vim-toggle" hidden><input type="checkbox"/> Vim mode</label>
			</div>
			<div class="actions">
				<button type="submit" name="action" value="run" class="secondary" hx-post={ url } hx-target="#output" hx-indicator="#running" hx-disabled-elt="#exercise button">Run</button>
				<button type="submit" name="action" value="submit" hx-post={ url } hx-target="#output" hx-indicator="#running" hx-disabled-elt="#exercise button">Submit</button>
				<span id="running" class="htmx-indicator">Running…</span>
				<button type="submit" name="action" value="reset" class="quiet" formnovalidate hx-post={ url } hx-target="#exercise" hx-swap="outerHTML" hx-confirm="Replace your code with the starter code?">Reset code</button>
			</div>
		</form>
		<div id="output" aria-live="polite">
			if out != nil {
				@Output(*out)
			}
		</div>
	</section>
}

// Exercise renders just the exercise panel, for htmx swaps.
templ Exercise(url, code string) {
	@exercise(url, code, nil)
}

// Output renders the result of Run or Submit.
templ Output(r RunResult) {
	if !r.Submit {
		<p class="verdict-line">Output <small>(test run, not graded)</small></p>
	} else if r.Passed {
		<p class="verdict-line right">Passed.</p>
	} else {
		<p class="verdict-line wrong">Not quite. Check the output and try again.</p>
	}
	if r.Expected != "" {
		<div class="compare">
			<div>
				<h3>Expected</h3>
				<pre>{ r.Expected }</pre>
			</div>
			<div>
				<h3>Your output</h3>
				<pre>{ r.Output }</pre>
			</div>
		</div>
	} else {
		<pre class="output">
			if r.Output == "" {
				<em>(no output)</em>
			} else {
				{ r.Output }
			}
		</pre>
	}
	if r.Submit && r.Passed {
		<p class="passed">
			if r.Practice && r.Next != nil {
				<a class="button" href={ templ.SafeURL(r.Next.URL) }>Next exercise →</a>
			} else if r.Practice {
				<span>That's the last exercise in this course.</span>
				<a class="button" href="/exercises">Back to exercises →</a>
			} else if r.Next != nil && r.Next.Course != "" {
				<span>You finished the course!</span>
				<a class="button" href={ templ.SafeURL(r.Next.URL) }>{ "Start " + r.Next.Course + " →" }</a>
			} else if r.Next != nil {
				<a class="button" href={ templ.SafeURL(r.Next.URL) }>Next lesson →</a>
			} else {
				<span>You finished the course!</span>
				<a class="button" href="/">Back to the roadmap →</a>
			}
		</p>
	}
	if r.Complete && r.Practice {
		<span id="lesson-status" hx-swap-oob="true"><span class="done">✓ Solved</span></span>
	} else if r.Complete {
		<span id="lesson-status" hx-swap-oob="true"><span class="done">✓ Completed</span> · </span>
	}
}

templ quiz(v Lesson) {
	<section class="panel" id="quiz">
		<h2>Quiz</h2>
		<form method="post" action={ templ.SafeURL(v.URL + "#quiz") }>
			for i, q := range v.Lesson.Quiz {
				<fieldset class={ questionClass(v.Quiz, i) }>
					<legend class="sr-only">{ fmt.Sprintf("Question %d", i+1) }</legend>
					@templ.Raw(q.Prompt)
					for j, o := range q.Options {
						<label>
							<input
								type="radio"
								name={ fmt.Sprintf("q%d", i) }
								value={ fmt.Sprint(j) }
								checked?={ v.Quiz != nil && v.Quiz.Chosen[i] == j }
								required
							/>
							<span>
								@templ.Raw(o.Text)
							</span>
						</label>
					}
					if v.Quiz != nil {
						if v.Quiz.Correct[i] {
							<p class="verdict">Correct.</p>
						} else {
							<p class="verdict">Not quite. Try again.</p>
						}
						<details open?={ v.Quiz.Correct[i] }>
							<summary>Explanation</summary>
							@templ.Raw(q.Explanation)
						</details>
					}
				</fieldset>
			}
			<button type="submit" name="action" value="quiz">Check answers</button>
		</form>
		if v.Quiz != nil && v.Quiz.Passed {
			<p class="passed">
				All correct.
				if v.Complete && v.Next != nil {
					<a class="button" href={ templ.SafeURL(v.Next.URL) }>Next lesson →</a>
				} else if v.Complete {
					<span>You finished the course!</span>
					<a class="button" href="/">Back to the roadmap →</a>
				} else {
					<span>Now finish the exercise.</span>
				}
			</p>
		}
	</section>
}

templ NotFound() {
	@layout("Not found · goland-engine") {
		<main class="narrow">
			<h1>404</h1>
			<p>That page doesn't exist. <a href="/">Back to the roadmap</a>.</p>
		</main>
	}
}

func questionClass(r *QuizResult, i int) string {
	switch {
	case r == nil:
		return ""
	case r.Correct[i]:
		return "right"
	default:
		return "wrong"
	}
}

// LessonURL builds the canonical URL of a lesson.
func LessonURL(courseSlug, chapterSlug, lessonSlug string) string {
	return "/courses/" + courseSlug + "/" + chapterSlug + "/" + lessonSlug
}

// Activity is a calendar of passed quizzes and exercises, grouped into weeks.
templ Activity(a store.Activity) {
	<section class="activity" aria-labelledby="activity-heading" data-activity>
		<div class="activity-heading">
			<h2 id="activity-heading">Your learning activity</h2>
			<span class="activity-period">Last 26 weeks</span>
		</div>
		<dl class="streak-stats">
			<div><dt>Current streak</dt><dd>{ fmt.Sprint(a.CurrentStreak) }<span>{ " " + plural(a.CurrentStreak, "day", "days") }</span></dd></div>
			<div><dt>Best streak</dt><dd>{ fmt.Sprint(a.BestStreak) }<span>{ " " + plural(a.BestStreak, "day", "days") }</span></dd></div>
			<div><dt>Today</dt><dd>{ fmt.Sprint(a.Today) }<span>{ " completed" }</span></dd></div>
		</dl>
		<div class="heatmap-scroll" tabindex="0" role="region" aria-label="Daily learning activity, Sunday through Saturday in each column">
			<div class="heatmap-layout">
				<div class="heatmap-weekdays" aria-hidden="true"><span>Sun</span><span></span><span>Tue</span><span></span><span>Thu</span><span></span><span>Sat</span></div>
				<div class="heatmap" role="list" aria-label="Daily completions">
					for _, day := range a.Days {
						if day.Future {
							<span class="heatmap-day future" aria-hidden="true"></span>
						} else {
							<span class={ heatmapClass(day.Count) } role="listitem" aria-label={ activityLabel(day) } data-date={ day.Date } data-count={ fmt.Sprint(day.Count) }>
								<span class="heatmap-tooltip" aria-hidden="true">{ activityLabel(day) }</span>
							</span>
						}
					}
				</div>
			</div>
		</div>
		<div class="activity-footer">
			<small>{ fmt.Sprintf("%d %s · %d active %s", a.Total, plural(a.Total, "completion", "completions"), a.ActiveDays, plural(a.ActiveDays, "day", "days")) }</small>
			<div class="heatmap-legend" role="group" aria-label="Daily completions: 0, 1–2, 3–5, 6–9, 10 or more">
				for level, label := range []string{"0", "1–2", "3–5", "6–9", "10+"} {
					<span><i class={ fmt.Sprintf("heatmap-day level-%d", level) } aria-hidden="true"></i>{ label }</span>
				}
			</div>
		</div>
		<p class="hint">Pass a lesson quiz or coding exercise to count toward your streak. Each counts once per day, including reviews.</p>
		if a.Today == 0 && a.CurrentStreak > 0 {
			<p class="activity-nudge">Keep it going—complete a quiz or exercise today.</p>
		} else if a.BestStreak == 0 {
			<p class="activity-nudge">Your first completion starts your streak.</p>
		}
		<p class="hint">Days use { a.Timezone }. Saved for this browser; clearing its cookies starts fresh.</p>
	</section>
}

func heatmapClass(count int) string {
	level := 0
	switch {
	case count >= 10:
		level = 4
	case count >= 6:
		level = 3
	case count >= 3:
		level = 2
	case count >= 1:
		level = 1
	}
	return fmt.Sprintf("heatmap-day level-%d", level)
}

func activityLabel(day store.ActivityDay) string {
	return fmt.Sprintf("%s: %d %s", day.Date, day.Count, plural(day.Count, "completed quiz or exercise", "completed quizzes and exercises"))
}

func plural(count int, singular, multiple string) string {
	if count == 1 {
		return singular
	}
	return multiple
}

// ExerciseList is the exercises page: practice problems grouped by course.
type ExerciseList struct {
	Groups  []ProblemGroup
	Courses []Link // every course with problems, for the filter; URL holds the slug
	Course  string // current course filter, "" for all
	Level   string // current difficulty filter, "" for all
	Empty   bool   // there are no problems at all
}

// ProblemGroup is one course's problems on the exercises page.
type ProblemGroup struct {
	Title    string
	Levels   []LevelCount // unfiltered totals for the course
	Problems []ProblemRow
}

// LevelCount is how many of a course's problems at one difficulty are solved.
type LevelCount struct {
	Level         string
	Solved, Total int
}

// ProblemRow is a problem in the list.
type ProblemRow struct {
	store.ProblemSummary
	URL    string
	Solved bool
}

// ProblemPage is a practice problem with the learner's code.
type ProblemPage struct {
	Problem    store.Problem
	URL        string
	Code       string
	Output     *RunResult
	Solved     bool
	Attempts   int
	Prev, Next *Link
}

// ProblemURL is where a practice problem lives.
func ProblemURL(courseSlug, problemSlug string) string {
	return "/exercises/" + courseSlug + "/" + problemSlug
}

func levelName(level string) string {
	switch level {
	case "easy":
		return "Easy"
	case "medium":
		return "Medium"
	case "hard":
		return "Hard"
	}
	return level
}

templ badge(level string) {
	<span class={ "badge " + level }>{ levelName(level) }</span>
}

templ Exercises(v ExerciseList) {
	@layout("Exercises · goland-engine") {
		<main class="narrow">
			<h1>Exercises</h1>
			<p>
				Standalone coding problems to sharpen what the courses teach. Each is graded like a
				lesson exercise and counts toward your streak. Easy problems use one idea from one
				chapter; medium ones combine a few; hard ones give you less scaffolding and include
				performance tests a naive solution won't pass.
			</p>
			if v.Empty {
				<p>Exercises are on their way. Check back soon.</p>
			} else {
				<form method="get" action="/exercises" class="filters">
					<label>
						Course
						<select name="course" onchange="this.form.requestSubmit()">
							<option value="">All courses</option>
							for _, c := range v.Courses {
								<option value={ c.URL } selected?={ c.URL == v.Course }>{ c.Title }</option>
							}
						</select>
					</label>
					<label>
						Difficulty
						<select name="level" onchange="this.form.requestSubmit()">
							<option value="">All levels</option>
							for _, l := range []string{"easy", "medium", "hard"} {
								<option value={ l } selected?={ l == v.Level }>{ levelName(l) }</option>
							}
						</select>
					</label>
					<button type="submit" class="secondary">Filter</button>
				</form>
				if len(v.Groups) == 0 {
					<p>No exercises match those filters.</p>
				}
				for _, g := range v.Groups {
					<section class="problem-group">
						<h2>{ g.Title }</h2>
						<p class="level-counts">
							for i, l := range g.Levels {
								if i > 0 {
									{ " · " }
								}
								{ fmt.Sprintf("%s %d/%d", levelName(l.Level), l.Solved, l.Total) }
							}
						</p>
						<ul class="problems">
							for _, p := range g.Problems {
								<li>
									<a href={ templ.SafeURL(p.URL) }>{ p.Title }</a>
									@badge(p.Difficulty)
									if p.Solved {
										<span class="done">✓ Solved</span>
									}
									if p.AfterTitle != "" {
										<small>{ "after " + p.AfterTitle }</small>
									}
								</li>
							}
						</ul>
					</section>
				}
			}
		</main>
	}
}

templ Problem(v ProblemPage) {
	@layout(v.Problem.Title + " · Exercises") {
		<main class="lesson">
			<article>
				<div class="crumbs">
					<p>
						<a href="/exercises">Exercises</a>
						/ { v.Problem.CourseTitle }
					</p>
					<div class="count">
						<span id="lesson-status">
							if v.Solved {
								<span class="done">✓ Solved</span>
							}
						</span>
						<nav class="lesson-nav" aria-label="Previous and next exercise">
							if v.Prev != nil {
								<a href={ templ.SafeURL(v.Prev.URL) } rel="prev" title={ v.Prev.Title }>← Previous</a>
							}
							if v.Next != nil {
								<a href={ templ.SafeURL(v.Next.URL) } rel="next" title={ v.Next.Title } class="next">Next →</a>
							}
						</nav>
					</div>
				</div>
				<h1>
					{ v.Problem.Title } @badge(v.Problem.Difficulty)
				</h1>
				if v.Problem.AfterTitle != "" {
					<p class="draws-on">
						Draws on
						<a href={ templ.SafeURL("/courses/" + v.Problem.Course + "#" + v.Problem.After) }>{ v.Problem.AfterTitle }</a>
						{ " in " + v.Problem.CourseTitle + "." }
					</p>
				}
				@templ.Raw(v.Problem.HTML)
				if len(v.Problem.Hints) > 0 {
					<section class="hints">
						<h2>Hints</h2>
						for i, h := range v.Problem.Hints {
							<details>
								<summary>{ fmt.Sprintf("Hint %d", i+1) }</summary>
								@templ.Raw(h)
							</details>
						}
					</section>
				}
				if v.Attempts > 0 {
					<p class="hint">{ fmt.Sprintf("%d %s so far.", v.Attempts, plural(v.Attempts, "submission", "submissions")) }</p>
				}
			</article>
			<aside class="panels">
				@exercise(v.URL, v.Code, v.Output)
			</aside>
			<script src="/static/editor.js" defer></script>
			<nav class="pager" aria-label="Exercise navigation">
				if v.Prev != nil {
					<a class="pager-link prev" href={ templ.SafeURL(v.Prev.URL) } rel="prev">
						<small>← Previous exercise</small>
						<span>{ v.Prev.Title }</span>
					</a>
				}
				if v.Next != nil {
					<a class="pager-link next" href={ templ.SafeURL(v.Next.URL) } rel="next">
						<small>Next exercise →</small>
						<span>{ v.Next.Title }</span>
					</a>
				} else {
					<a class="pager-link next" href="/exercises">
						<small>Last exercise in this course</small>
						<span>Back to exercises →</span>
					</a>
				}
			</nav>
		</main>
	}
}
